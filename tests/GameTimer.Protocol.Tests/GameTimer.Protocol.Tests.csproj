<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <!-- The real relay in memory, for the agent's RelayClient (RelayClientTests.cs) -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.11" />
  </ItemGroup>

  <!-- Kestrel for the real-WebSocket tests (Agent/WebSocketTests.cs) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameTimer.Protocol\GameTimer.Protocol.csproj" />
    <ProjectReference Include="..\..\src\GameTimer.Relay\GameTimer.Relay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Published Noise test vectors (see tests/vectors/README.md), shared with the Kotlin tests -->
    <None Include="..\vectors\noise-vectors.json" Link="vectors\noise-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\vectors\protocol-vectors.json" Link="vectors\protocol-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
