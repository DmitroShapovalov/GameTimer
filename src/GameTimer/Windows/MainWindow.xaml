<ui:FluentWindow x:Class="GameTimer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="GameTimer"
        Width="880" Height="620" MinWidth="720" MinHeight="520"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <!-- The navigation pane: items like NavigationViewItem (icon + text, a pill and an accent bar when selected) -->
        <Style x:Key="NavTabItem" TargetType="TabItem">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="12,9">
                            <Grid>
                                <Rectangle x:Name="Bar" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                           HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Hidden"
                                           Fill="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavTabControl" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" IsItemsHost="True" Margin="8,4,8,0" KeyboardNavigation.TabNavigation="Once"/>
                                <ContentPresenter Grid.Row="1" Content="{TemplateBinding Tag}"/>
                            </Grid>
                            <!-- The content layer: a lighter surface with a rounded top-left corner, as in Windows 11 Settings -->
                            <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                                    CornerRadius="8,0,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="16,8,16,0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A setting card (as in Windows 11 Settings): icon, title + description, control on the right -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="PageHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <!-- A day on the Schedule page: the whole row is a radio button (arrow keys move between days) -->
        <Style x:Key="DayRow" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="12,7">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                            <Border x:Name="Mark" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A filter chip on the History page: a pill-shaped radio button -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="14" Padding="14,5" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A colour swatch: a round radio button (keyboard and screen readers reach it like any radio) -->
        <Style x:Key="SwatchRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" CornerRadius="13" BorderThickness="1" Padding="2"
                                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                            <Border CornerRadius="10" Background="{TemplateBinding Background}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderThickness" Value="3"/>
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="GameTimer"/>

        <!-- Left navigation like Windows 11 Settings (a TabControl styled as a NavigationView, so every
             control keeps its name): Timer, Schedule, History on top, the rarely changed pages below,
             and the parent lock at the bottom of the pane -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource NavTabControl}">
            <TabControl.Tag>
                <ui:Button x:Name="LockButton" Appearance="Transparent" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left" Margin="8,0,8,12" Padding="10,8"
                           Click="LockButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="LockIcon" Symbol="LockClosed24" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock x:Name="LockTitle" Text="Locked" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LockSubtitle" Text="Click to unlock" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Button>
            </TabControl.Tag>
            <!-- TAB: Timer -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Timer24" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TabTimerText" Text="Timer"/>
                    </StackPanel>
                </TabItem.Header>
                <!-- Status: the PC's state first (as on the phone), then the everyday actions; with no timer,
                     the start form takes the actions' place -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,8,16,16">
                    <ui:InfoBar x:Name="InterruptionBar" Severity="Warning" IsOpen="False" IsClosable="False"
                                Margin="0,0,0,8"/>
                    <ui:Button x:Name="InterruptionDismiss" Content="Got it" Appearance="Secondary"
                               HorizontalAlignment="Right" Margin="0,0,0,12" Visibility="Collapsed"
                               Click="InterruptionDismiss_Click"/>
                    <TextBlock x:Name="StatusHeader" Text="Status" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <!-- Ring and actions side by side; on a narrow window the actions go below the ring -->
                    <WrapPanel>
                        <!-- The ring: the time left against the timer's length (MainWindow.UpdateRing) -->
                        <Grid Width="200" Height="200" Margin="0,0,32,16" VerticalAlignment="Top">
                            <Ellipse Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="12" Margin="6" Opacity="0.35"/>
                            <Path x:Name="RingArc" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="RemainingText" Text="" FontSize="34" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="EndTimeText" Text="" FontSize="13" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Width="340">
                            <Border x:Name="StateBadge" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,0,8">
                                <TextBlock x:Name="StatusText" Text="Timer not started" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="ThenText" Text="" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="ScheduleLineText" Text="" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

                            <!-- A running timer: − / + by a chosen step, Lift, and the rarer actions under More -->
                            <StackPanel x:Name="RunningPanel" Visibility="Collapsed">
                                <WrapPanel Margin="0,0,0,8">
                                    <ui:Button x:Name="MinusButton" Content="−15 min" MinWidth="96" Height="34"
                                               Margin="0,0,8,0" Click="Minus_Click"/>
                                    <ui:Button x:Name="PlusButton" Content="+15 min" MinWidth="96" Height="34"
                                               Appearance="Primary" Margin="0,0,12,0" Click="Plus_Click"/>
                                    <TextBlock x:Name="StepLabel" Text="Step:" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ComboBox x:Name="StepCombo" Width="80" VerticalAlignment="Center"
                                              SelectionChanged="StepCombo_Changed"/>
                                </WrapPanel>
                            </StackPanel>
                            <!-- Lift: with a timer, or without one while the schedule limits today -->
                            <WrapPanel Margin="0,0,0,8">
                                    <ui:Button x:Name="StopButton" Content="Lift restrictions" MinWidth="160" Height="34"
                                               Margin="0,0,8,8" Click="Stop_Click" IsEnabled="False"/>
                                    <ui:Button x:Name="MoreButton" Content="More" Height="34" Appearance="Secondary"
                                               Icon="{ui:SymbolIcon MoreHorizontal24}" Click="MoreButton_Click">
                                        <ui:Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem x:Name="EndAtMenu" Header="End at…" Click="EndAtMenu_Click"/>
                                                <MenuItem x:Name="EndNowButton" Header="End now" Click="EndNow_Click" IsEnabled="False"/>
                                                <MenuItem x:Name="ResetButton" Header="Reset" Click="Reset_Click" IsEnabled="False"/>
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>
                                    </ui:Button>
                            </WrapPanel>
                            <!-- End at: opened from More -->
                            <StackPanel x:Name="EndAtPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
                                    <TextBlock x:Name="EndAtLabel" Text="End at:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ui:TextBox x:Name="EndAtHour" Width="64" MaxLength="2" VerticalAlignment="Center"
                                                PreviewTextInput="TimeInput_PreviewTextInput" GotKeyboardFocus="TimeInput_GotFocus"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0,4,0" FontWeight="Bold"/>
                                    <ui:TextBox x:Name="EndAtMinute" Width="64" MaxLength="2" VerticalAlignment="Center"
                                                PreviewTextInput="TimeInput_PreviewTextInput" GotKeyboardFocus="TimeInput_GotFocus"/>
                                    <ui:Button x:Name="EndAtButton" Content="Set" Height="34" Margin="8,0,0,0" Click="EndAt_Click"/>
                            </StackPanel>

                            <!-- No timer: For / Until, presets, the time, Start -->
                            <StackPanel x:Name="StartPanel">
                                <TextBlock x:Name="ModeLabel" Text="Mode" Style="{StaticResource SectionLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton x:Name="ModeInterval" Content="Interval" IsChecked="True" GroupName="Mode"
                                                 Style="{StaticResource {x:Type ToggleButton}}" MinWidth="110" Height="32"
                                                 Checked="Mode_Changed"/>
                                    <RadioButton x:Name="ModeAbsolute" Content="Time of day" GroupName="Mode"
                                                 Style="{StaticResource {x:Type ToggleButton}}" MinWidth="110" Height="32"
                                                 Margin="4,0,0,0" Checked="Mode_Changed"/>
                                </StackPanel>
                                <StackPanel x:Name="IntervalPanel" Margin="0,0,0,12">
                                    <WrapPanel x:Name="PresetPanel" Margin="0,0,0,8">
                                        <ui:Button Content="0:30" Tag="30" MinWidth="60" Margin="0,0,6,6" Click="Preset_Click"/>
                                        <ui:Button Content="1:00" Tag="60" MinWidth="60" Margin="0,0,6,6" Click="Preset_Click"/>
                                        <ui:Button Content="1:30" Tag="90" MinWidth="60" Margin="0,0,6,6" Click="Preset_Click"/>
                                        <ui:Button Content="2:00" Tag="120" MinWidth="60" Margin="0,0,6,6" Click="Preset_Click"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="HoursLabel" Text="Hours:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ui:TextBox x:Name="IntervalHours" Width="72"
                                                 PreviewKeyDown="TimeInput_PreviewKeyDown" PreviewTextInput="TimeInput_PreviewTextInput"
                                                 GotKeyboardFocus="TimeInput_GotFocus" MaxLength="2" Text="1" VerticalAlignment="Center"
                                                 TextChanged="TimerInput_Changed"/>
                                        <TextBlock x:Name="MinutesLabel" Text="Minutes:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                        <ui:TextBox x:Name="IntervalMinutes" Width="72"
                                                 PreviewKeyDown="TimeInput_PreviewKeyDown" PreviewTextInput="TimeInput_PreviewTextInput"
                                                 GotKeyboardFocus="TimeInput_GotFocus" MaxLength="2" Text="0" VerticalAlignment="Center"
                                                 TextChanged="TimerInput_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="AbsolutePanel" Orientation="Horizontal" Margin="0,0,0,12"
                                            Visibility="Collapsed">
                                    <TextBlock x:Name="HourLabel" Text="Hour:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ui:TextBox x:Name="AbsoluteHour" Width="72"
                                             PreviewKeyDown="TimeInput_PreviewKeyDown" PreviewTextInput="TimeInput_PreviewTextInput"
                                             GotKeyboardFocus="TimeInput_GotFocus" MaxLength="2" Text="20" VerticalAlignment="Center"
                                             TextChanged="TimerInput_Changed"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0,4,0" FontWeight="Bold"/>
                                    <ui:TextBox x:Name="AbsoluteMinute" Width="72"
                                             PreviewKeyDown="TimeInput_PreviewKeyDown" PreviewTextInput="TimeInput_PreviewTextInput"
                                             GotKeyboardFocus="TimeInput_GotFocus" MaxLength="2" Text="00" VerticalAlignment="Center"
                                             TextChanged="TimerInput_Changed"/>
                                </StackPanel>
                                <TextBlock x:Name="ValidationText" Text="" FontSize="12"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,0,4" Visibility="Collapsed"/>
                                <ui:Button x:Name="StartButton" Content="Start" MinWidth="200" Height="36"
                                           Click="Start_Click" Appearance="Primary" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TAB: Schedule -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Calendar24" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TabScheduleText" Text="Schedule"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8,4,16">
                        <TextBlock x:Name="ScheduleLabel" Text="Schedule" Style="{StaticResource PageHeader}"/>
                        <TextBlock x:Name="ScheduleIntro" Style="{StaticResource CardDescription}" Margin="0,-8,0,12"
                                   Text="A daily time budget and the hours gaming is allowed, per weekday."/>
                        <ui:InfoBar x:Name="ScheduleStatusBar" IsOpen="True" IsClosable="False"
                                    Severity="Informational" Margin="0,0,0,8"/>
                        <ui:Button x:Name="ScheduleUnlockButton" Content="Unlock to edit" Icon="{ui:SymbolIcon LockOpen24}"
                                   Click="ScheduleUnlock_Click" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="ScheduleEnableTitle" Text="Weekly schedule" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="ScheduleHint" Style="{StaticResource CardDescription}"/>
                                </StackPanel>
                                <ContentControl x:Name="ScheduleEditPanel" Grid.Column="2" VerticalAlignment="Center"
                                                Focusable="False" IsEnabled="False">
                                    <ui:ToggleSwitch x:Name="ScheduleEnabledToggle"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=ScheduleEnableTitle}"
                                                     Checked="ScheduleEnabled_Changed" Unchecked="ScheduleEnabled_Changed"/>
                                </ContentControl>
                            </Grid>
                        </Border>
                        <!-- The week at a glance; a row selects the day for the editor below (works while locked too) -->
                        <Border Style="{StaticResource SettingCard}" Padding="4,6">
                            <StackPanel x:Name="ScheduleDaysPanel" KeyboardNavigation.TabNavigation="Once"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                        <!-- The selected day -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel x:Name="ScheduleDayEditor" IsEnabled="False">
                                <TextBlock x:Name="ScheduleDayTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SchedAllowedLabel" Text="Gaming allowed" Style="{StaticResource CardTitle}"
                                               VerticalAlignment="Center"/>
                                    <ContentControl Grid.Column="1" Focusable="False">
                                        <ui:ToggleSwitch x:Name="ScheduleDayAllowed"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=SchedAllowedLabel}"
                                                         Checked="ScheduleDay_Changed" Unchecked="ScheduleDay_Changed"/>
                                    </ContentControl>
                                </Grid>
                                <StackPanel x:Name="ScheduleDayDetails">
                                    <TextBlock x:Name="SchedHoursLabel" Text="Allowed hours" Style="{StaticResource CardTitle}" Margin="0,4,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBox x:Name="ScheduleDayFrom" Width="84" MaxLength="5"
                                                    TextChanged="ScheduleDay_TextChanged" LostFocus="ScheduleDay_LostFocus"
                                                    KeyDown="ScheduleDay_KeyDown"/>
                                        <TextBlock Text="&#x2013;" Margin="8,0" VerticalAlignment="Center"/>
                                        <ui:TextBox x:Name="ScheduleDayTo" Width="84" MaxLength="5"
                                                    TextChanged="ScheduleDay_TextChanged" LostFocus="ScheduleDay_LostFocus"
                                                    KeyDown="ScheduleDay_KeyDown"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ScheduleWindowError" Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                               AutomationProperties.LiveSetting="Polite"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed"/>
                                    <Grid Margin="0,16,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SchedLimitLabel" Text="Daily limit" Style="{StaticResource CardTitle}"
                                                   VerticalAlignment="Center"/>
                                        <ContentControl Grid.Column="1" Focusable="False">
                                            <ui:ToggleSwitch x:Name="ScheduleDayLimitOn"
                                                             AutomationProperties.LabeledBy="{Binding ElementName=SchedLimitLabel}"
                                                             Checked="ScheduleDay_Changed" Unchecked="ScheduleDay_Changed"/>
                                        </ContentControl>
                                    </Grid>
                                    <StackPanel x:Name="ScheduleLimitRow" Orientation="Horizontal">
                                        <ui:Button x:Name="ScheduleLimitMinus" Icon="{ui:SymbolIcon Subtract24}" Click="ScheduleLimitStep_Click"/>
                                        <ui:TextBox x:Name="ScheduleDayLimit" Width="72" Margin="6,0" MaxLength="4"
                                                    AutomationProperties.LabeledBy="{Binding ElementName=SchedLimitLabel}"
                                                    TextChanged="ScheduleDay_TextChanged" LostFocus="ScheduleDay_LostFocus"
                                                    KeyDown="ScheduleDay_KeyDown"/>
                                        <ui:Button x:Name="ScheduleLimitPlus" Icon="{ui:SymbolIcon Add24}" Click="ScheduleLimitStep_Click"/>
                                        <TextBlock x:Name="ScheduleLimitUnit" Text="min" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ScheduleLimitHint" Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                                <TextBlock x:Name="SchedCopyLabel" Text="Copy this day to" Style="{StaticResource CardDescription}"
                                           Margin="0,16,0,6"/>
                                <WrapPanel>
                                    <ui:Button x:Name="ScheduleCopyWeekdays" Content="Weekdays" Tag="weekdays"
                                               Click="ScheduleCopy_Click" Margin="0,0,8,4"/>
                                    <ui:Button x:Name="ScheduleCopyWeekend" Content="Weekend" Tag="weekend"
                                               Click="ScheduleCopy_Click" Margin="0,0,8,4"/>
                                    <ui:Button x:Name="ScheduleCopyEveryDay" Content="Every day" Tag="all"
                                               Click="ScheduleCopy_Click" Margin="0,0,8,4"/>
                                    <TextBlock x:Name="ScheduleCopied" VerticalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TAB: History -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="History24" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TabHistoryText" Text="History"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="4,8,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HistoryHeader" Text="History" Style="{StaticResource PageHeader}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" KeyboardNavigation.TabNavigation="Once"
                                KeyboardNavigation.DirectionalNavigation="Cycle">
                        <RadioButton x:Name="HistFilterAll" Content="All" GroupName="HistoryFilter" IsChecked="True"
                                     Style="{StaticResource FilterChip}" Checked="HistoryFilter_Checked"
                                     GotKeyboardFocus="HistoryFilter_GotKeyboardFocus"/>
                        <RadioButton x:Name="HistFilterTimer" Content="Timer" GroupName="HistoryFilter"
                                     Style="{StaticResource FilterChip}" Checked="HistoryFilter_Checked"
                                     GotKeyboardFocus="HistoryFilter_GotKeyboardFocus"/>
                        <RadioButton x:Name="HistFilterAlerts" Content="Alerts" GroupName="HistoryFilter"
                                     Style="{StaticResource FilterChip}" Checked="HistoryFilter_Checked"
                                     GotKeyboardFocus="HistoryFilter_GotKeyboardFocus"/>
                    </StackPanel>
                    <TextBlock x:Name="HistoryEmpty" Grid.Row="2" Text="No events yet" Visibility="Collapsed" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ScrollViewer x:Name="HistoryScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HistoryPanel" Margin="0,0,0,16"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- TAB: Display -->
            <!-- The second group, at the bottom of the navigation: rarely changed -->
            <TabItem Margin="0,24,0,2">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PaintBrush24" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TabDisplayText" Text="Display"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8,4,16">
                        <TextBlock x:Name="OverlayHeader" Text="Timer on screen" Style="{StaticResource PageHeader}"/>
                        <!-- Live preview: a small screen; the marker looks like the countdown (zone colour, size, opacity,
                             background) and is dragged to where it shows -->
                        <TextBlock x:Name="OverlayPositionLabel" Text="Overlay position (drag the marker)" Style="{StaticResource SectionLabel}"/>
                        <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8"
                                Height="160" Margin="0,0,0,8" Background="#1a1a2e" ClipToBounds="True">
                            <Canvas x:Name="PositionCanvas" MouseLeftButtonDown="Canvas_MouseDown"
                                    MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp">
                                <Border x:Name="PositionMarker" Canvas.Left="0" Canvas.Top="0" CornerRadius="4" Padding="6,2" Cursor="SizeAll">
                                    <TextBlock x:Name="PreviewText" Text="01:30" FontFamily="Consolas, Courier New" FontWeight="Bold"/>
                                </Border>
                            </Canvas>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton x:Name="PreviewNormal" Content="Normal" GroupName="PreviewZone" IsChecked="True"
                                         Style="{StaticResource {x:Type ToggleButton}}" MinWidth="90" Checked="PreviewZone_Changed"/>
                            <RadioButton x:Name="PreviewWarning" Content="Warning" GroupName="PreviewZone" Margin="4,0,0,0"
                                         Style="{StaticResource {x:Type ToggleButton}}" MinWidth="90" Checked="PreviewZone_Changed"/>
                            <RadioButton x:Name="PreviewAlert" Content="Alert" GroupName="PreviewZone" Margin="4,0,0,0"
                                         Style="{StaticResource {x:Type ToggleButton}}" MinWidth="90" Checked="PreviewZone_Changed"/>
                        </StackPanel>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FontSizeSectionLabel" Text="Font size" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="72" Value="24" Width="220"
                                            VerticalAlignment="Center" ValueChanged="FontSize_Changed"
                                            AutomationProperties.LabeledBy="{Binding ElementName=FontSizeSectionLabel}"/>
                                    <TextBlock x:Name="FontSizeLabel" Text="24 px" Margin="8,0,0,0" VerticalAlignment="Center" Width="50"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OpacitySectionLabel" Text="Opacity" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Value="70" Width="220"
                                            VerticalAlignment="Center" ValueChanged="Opacity_Changed"
                                            AutomationProperties.LabeledBy="{Binding ElementName=OpacitySectionLabel}"/>
                                    <TextBlock x:Name="OpacityLabel" Text="70%" Margin="8,0,0,0" VerticalAlignment="Center" Width="50"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <CheckBox x:Name="ShowBackgroundCheck" Content="Background behind text" IsChecked="True"
                                      Checked="DisplaySetting_Changed" Unchecked="DisplaySetting_Changed"/>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock x:Name="ThresholdsLabel" Text="Thresholds (minutes)" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <TextBlock x:Name="WarningFromLabel" Text="Warning:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ui:TextBox x:Name="YellowThreshold" Width="64" Text="30" TextChanged="Threshold_Changed"
                                                PreviewTextInput="TimeInput_PreviewTextInput"/>
                                    <TextBlock x:Name="MinLabel1" Text="min" VerticalAlignment="Center" Margin="4,0,16,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="AlertFromLabel" Text="Alert:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ui:TextBox x:Name="RedThreshold" Width="64" Text="10" TextChanged="Threshold_Changed"
                                                PreviewTextInput="TimeInput_PreviewTextInput"/>
                                    <TextBlock x:Name="MinLabel2" Text="min" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock x:Name="ZoneColorsLabel" Text="Zone colors" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NormalZoneLabel" Text="Normal" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" x:Name="GreenPreview" Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0"
                                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1"/>
                                    <WrapPanel Grid.Column="2" x:Name="GreenPalette" VerticalAlignment="Center"/>
                                    <ui:TextBox Grid.Column="3" x:Name="GreenHex" Width="96" AutomationProperties.LabeledBy="{Binding ElementName=NormalZoneLabel}" MaxLength="7" VerticalAlignment="Center"
                                                LostKeyboardFocus="ColorHex_LostFocus" KeyDown="ColorHex_KeyDown"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WarningZoneLabel" Text="Warning" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" x:Name="YellowPreview" Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0"
                                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1"/>
                                    <WrapPanel Grid.Column="2" x:Name="YellowPalette" VerticalAlignment="Center"/>
                                    <ui:TextBox Grid.Column="3" x:Name="YellowHex" Width="96" AutomationProperties.LabeledBy="{Binding ElementName=WarningZoneLabel}" MaxLength="7" VerticalAlignment="Center"
                                                LostKeyboardFocus="ColorHex_LostFocus" KeyDown="ColorHex_KeyDown"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AlertZoneLabel" Text="Alert" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" x:Name="RedPreview" Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0"
                                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1"/>
                                    <WrapPanel Grid.Column="2" x:Name="RedPalette" VerticalAlignment="Center"/>
                                    <ui:TextBox Grid.Column="3" x:Name="RedHex" Width="96" AutomationProperties.LabeledBy="{Binding ElementName=AlertZoneLabel}" MaxLength="7" VerticalAlignment="Center"
                                                LostKeyboardFocus="ColorHex_LostFocus" KeyDown="ColorHex_KeyDown"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="AlertPointsLabel" Text="Sound alert points" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                        <ItemsControl x:Name="AlertsList" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A chip per alert point: on / off, the minutes, remove -->
                                    <Border CornerRadius="16" Padding="10,2,4,2" Margin="0,0,8,8"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding DisplayText}"
                                                      Checked="AlertEnabled_Changed" Unchecked="AlertEnabled_Changed"/>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" Margin="0,0,4,0"/>
                                            <ui:Button Appearance="Transparent" Width="28" Height="28" Padding="0"
                                                       Click="RemoveAlert_Click" Tag="{Binding}"
                                                       AutomationProperties.Name="{Binding DisplayText}">
                                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="12"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:TextBox x:Name="NewAlertMinutes" Width="70" Margin="0,0,8,0"
                                        KeyDown="NewAlertMinutes_KeyDown" PreviewTextInput="TimeInput_PreviewTextInput" MaxLength="3"
                                        PlaceholderText="min"/>
                            <ui:Button x:Name="AddButton" Content="Add" Click="AddAlert_Click" Icon="{ui:SymbolIcon Add24}"/>
                        </StackPanel>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock x:Name="SoundFileLabel" Text="Sound file" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="SoundBuiltIn" Content="Built-in" IsChecked="True"
                                                 Checked="SoundSource_Changed" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="SoundCustom" Content="Custom file" Checked="SoundSource_Changed"/>
                                </StackPanel>
                                <StackPanel x:Name="CustomSoundPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
                                    <ui:TextBox x:Name="CustomSoundPath" Width="260" IsReadOnly="True" Margin="0,0,8,0"/>
                                    <ui:Button x:Name="BrowseButton" Content="Browse..." Click="BrowseSound_Click"/>
                                </StackPanel>
                                <ui:Button x:Name="PreviewButton" Content="Preview" HorizontalAlignment="Left"
                                           Click="PreviewSound_Click" Icon="{ui:SymbolIcon Speaker224}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TAB: Phones -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Phone24" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TabPhonesText" Text="Phones"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8,4,16">
                        <TextBlock x:Name="PhonesHeader" Text="Phones" Style="{StaticResource PageHeader}"/>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Phone24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="PhoneControlLabel" Text="Phone control" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="RemoteToggleText" Style="{StaticResource CardDescription}"/>
                                    <TextBlock x:Name="RemoteStatusText" Style="{StaticResource CardDescription}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ContentControl Grid.Column="2" VerticalAlignment="Center" Focusable="False">
                                    <ui:ToggleSwitch x:Name="RemoteToggle" AutomationProperties.LabeledBy="{Binding ElementName=PhoneControlLabel}"
                                                     Checked="RemoteToggle_Changed" Unchecked="RemoteToggle_Changed"/>
                                </ContentControl>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="FirewallPanel" Margin="0,0,0,4" Visibility="Collapsed">
                            <ui:InfoBar x:Name="FirewallInfo" Title="Windows Firewall" IsOpen="True" IsClosable="False" Severity="Warning" Margin="0,0,0,4"/>
                            <ui:Button x:Name="FirewallButton" Content="Allow in firewall" Click="FirewallButton_Click"/>
                        </StackPanel>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="PhoneAdd24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="ConnectPhoneTitle" Text="Connect a phone" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="ConnectPhoneDesc" Text="Scan the QR code with the GameTimer app on the phone" Style="{StaticResource CardDescription}"/>
                                </StackPanel>
                                <ContentControl Grid.Column="2" VerticalAlignment="Center" Focusable="False">
                                    <ui:Button x:Name="ConnectPhoneButton" Content="Connect phone" Click="ConnectPhone_Click"
                                               Appearance="Primary" IsEnabled="False"/>
                                </ContentControl>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Globe24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="RemoteAccessTitle" Text="Control from anywhere" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="RemoteAccessText" Style="{StaticResource CardDescription}"/>
                                </StackPanel>
                                <ContentControl Grid.Column="2" VerticalAlignment="Center" Focusable="False">
                                    <ui:ToggleSwitch x:Name="RemoteAccessToggle" AutomationProperties.LabeledBy="{Binding ElementName=RemoteAccessTitle}"
                                                     Checked="RemoteAccessToggle_Changed" Unchecked="RemoteAccessToggle_Changed"/>
                                </ContentControl>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="PairedDevicesLabel" Text="Paired phones" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                        <TextBlock x:Name="NoDevicesText" Text="No phones connected yet" Style="{StaticResource CardDescription}"/>
                        <ItemsControl x:Name="DevicesList" Margin="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding LastSeenText}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Appearance="Secondary"
                                                   Width="30" Height="30" Padding="0"
                                                   Click="RevokeDevice_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Name}">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="14"/>
                                        </ui:Button>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Protocol v2 parent apps (role, revoke) -->
                        <ItemsControl x:Name="PeersList" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Appearance="Secondary" Margin="0,0,4,0"
                                                   Width="30" Height="30" Padding="0" ToolTip="{Binding RoleButtonTip}"
                                                   Click="TogglePeerRole_Click" Tag="{Binding}" AutomationProperties.Name="{Binding RoleButtonTip}">
                                            <ui:SymbolIcon Symbol="PersonKey20" FontSize="14"/>
                                        </ui:Button>
                                        <ui:Button Grid.Column="2" Appearance="Secondary"
                                                   Width="30" Height="30" Padding="0"
                                                   Click="RevokePeer_Click" Tag="{Binding}" ToolTip="{Binding RevokeTip}" AutomationProperties.Name="{Binding RevokeTip}">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="14"/>
                                        </ui:Button>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TAB: Settings -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TabSettingsText" Text="Settings"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8,4,16">
                        <TextBlock x:Name="SettingsHeader" Text="Settings" Style="{StaticResource PageHeader}"/>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="LanguageLabel" Text="Language" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="LanguageDesc" Text="This app and the countdown" Style="{StaticResource CardDescription}"/>
                                </StackPanel>
                                <ContentControl Grid.Column="2" VerticalAlignment="Center" Focusable="False">
                                    <ComboBox x:Name="LanguageCombo" MinWidth="150" SelectionChanged="Language_Changed">
                                        <ComboBoxItem Content="English" Tag="en"/>
                                        <ComboBoxItem Content="Русский" Tag="ru"/>
                                        <ComboBoxItem Content="Nederlands" Tag="nl"/>
                                        <ComboBoxItem Content="Українська" Tag="uk"/>
                                    </ComboBox>
                                </ContentControl>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Power24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="ActionLabel" Text="Action when timer expires" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="ActionDesc" Text="What the PC does when the time is up" Style="{StaticResource CardDescription}"/>
                                </StackPanel>
                                <ContentControl Grid.Column="2" VerticalAlignment="Center" Focusable="False">
                                    <ComboBox x:Name="ActionCombo" MinWidth="150" SelectionChanged="Action_Changed">
                                        <ComboBoxItem x:Name="ActionShutdown" Content="Shut down computer"/>
                                        <ComboBoxItem x:Name="ActionLock" Content="Lock screen"/>
                                        <ComboBoxItem x:Name="ActionLogoff" Content="Log off"/>
                                    </ComboBox>
                                </ContentControl>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ShieldLock24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="TamperLabel" Text="Protection from closing" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="TamperHint" Style="{StaticResource CardDescription}"/>
                                </StackPanel>
                                <ContentControl Grid.Column="2" VerticalAlignment="Center" Focusable="False">
                                    <ui:ToggleSwitch x:Name="TamperToggle" AutomationProperties.LabeledBy="{Binding ElementName=TamperLabel}"
                                                     Checked="TamperToggle_Changed" Unchecked="TamperToggle_Changed"/>
                                </ContentControl>
                            </Grid>
                        </Border>
                        <ui:InfoBar x:Name="ProtectionInfo" Title="Protection" IsOpen="True" IsClosable="False"
                                    Severity="Informational" Margin="0,12,0,0"
                                    Message="Timer controls are protected by Windows Hello (PIN / fingerprint / face)."/>

                        <TextBlock x:Name="AboutLabel" Text="About" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Info24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="VersionText" Text="GameTimer" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="AppDescriptionText" Text="Game time limiter for Windows" Style="{StaticResource CardDescription}"/>
                                </StackPanel>
                                <ContentControl Grid.Column="2" VerticalAlignment="Center" Focusable="False">
                                    <WrapPanel MaxWidth="240" HorizontalAlignment="Right">
                                        <ui:HyperlinkButton x:Name="PrivacyLink" Content="Privacy"
                                                            NavigateUri="https://github.com/DmitroShapovalov/GameTimer/blob/master/docs/PRIVACY.md"/>
                                        <ui:HyperlinkButton x:Name="SourceLink" Content="Source code"
                                                            NavigateUri="https://github.com/DmitroShapovalov/GameTimer"/>
                                    </WrapPanel>
                                </ContentControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
