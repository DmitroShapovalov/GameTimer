<Window x:Class="GameTimer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameTimer"
        Width="440" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl Margin="8">

            <!-- TAB: Timer -->
            <TabItem Header="Таймер">
                <StackPanel Margin="12">
                    <!-- Mode selector -->
                    <TextBlock Text="Режим" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="ModeInterval" Content="Интервал" IsChecked="True"
                                     Checked="Mode_Changed" Margin="0,0,16,0"/>
                        <RadioButton x:Name="ModeAbsolute" Content="Время дня"
                                     Checked="Mode_Changed"/>
                    </StackPanel>

                    <!-- Interval inputs -->
                    <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Часы:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="IntervalHours" Width="50" Text="1" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                        <TextBlock Text="Минуты:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox x:Name="IntervalMinutes" Width="50" Text="0" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                    </StackPanel>

                    <!-- Absolute inputs -->
                    <StackPanel x:Name="AbsolutePanel" Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="Collapsed">
                        <TextBlock Text="Час:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="AbsoluteHour" Width="50" Text="20" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                        <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0,4,0" FontWeight="Bold"/>
                        <TextBox x:Name="AbsoluteMinute" Width="50" Text="00" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                    </StackPanel>

                    <!-- Status -->
                    <Border Background="#F5F5F5" CornerRadius="6" Padding="12" Margin="0,4,0,12">
                        <StackPanel>
                            <TextBlock x:Name="StatusText" Text="Таймер не запущен"
                                       FontSize="13" Foreground="Gray"/>
                            <TextBlock x:Name="RemainingText" Text=""
                                       FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartButton" Content="Старт" Width="90" Height="32"
                                Margin="0,0,8,0" Click="Start_Click"
                                Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                        <Button x:Name="StopButton" Content="Стоп" Width="90" Height="32"
                                Margin="0,0,8,0" Click="Stop_Click" IsEnabled="False"/>
                        <Button x:Name="ResetButton" Content="Сброс" Width="90" Height="32"
                                Click="Reset_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- TAB: Display -->
            <TabItem Header="Отображение">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- Position preview -->
                        <TextBlock Text="Позиция оверлея (перетащите маркер)" Style="{StaticResource SectionLabel}"/>
                        <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4"
                                Height="120" Margin="0,0,0,12" Background="#1a1a2e">
                            <Canvas x:Name="PositionCanvas" MouseLeftButtonDown="Canvas_MouseDown"
                                    MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp">
                                <Border x:Name="PositionMarker" Canvas.Left="0" Canvas.Top="0"
                                        Background="#4CAF50" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="01:30" Foreground="White" FontFamily="Consolas"
                                               FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Canvas>
                        </Border>

                        <!-- Font size -->
                        <TextBlock Text="Размер шрифта" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="72" Value="24"
                                    Width="280" VerticalAlignment="Center"
                                    ValueChanged="FontSize_Changed"/>
                            <TextBlock x:Name="FontSizeLabel" Text="24 px" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Width="50"/>
                        </StackPanel>

                        <!-- Opacity -->
                        <TextBlock Text="Прозрачность" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Value="70"
                                    Width="280" VerticalAlignment="Center"
                                    ValueChanged="Opacity_Changed"/>
                            <TextBlock x:Name="OpacityLabel" Text="70%" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Width="50"/>
                        </StackPanel>

                        <!-- Background toggle -->
                        <CheckBox x:Name="ShowBackgroundCheck" Content="Фон за текстом"
                                  IsChecked="True" Margin="0,4,0,12"
                                  Checked="DisplaySetting_Changed" Unchecked="DisplaySetting_Changed"/>

                        <!-- Color thresholds -->
                        <TextBlock Text="Пороги (минуты)" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Жёлтый с:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="YellowThreshold" Width="50" Text="30"
                                     TextChanged="Threshold_Changed"/>
                            <TextBlock Text="мин" VerticalAlignment="Center" Margin="4,0,16,0"
                                       Foreground="Gray"/>
                            <TextBlock Text="Красный с:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="RedThreshold" Width="50" Text="10"
                                     TextChanged="Threshold_Changed"/>
                            <TextBlock Text="мин" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="Gray"/>
                        </StackPanel>

                        <!-- Colors -->
                        <TextBlock Text="Цвета зон (hex)" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border x:Name="GreenPreview" Width="20" Height="20" CornerRadius="3"
                                    Background="#4CAF50" Margin="0,0,4,0"/>
                            <TextBox x:Name="GreenColor" Width="80" Text="#4CAF50"
                                     TextChanged="Color_Changed"/>
                            <Border x:Name="YellowPreview" Width="20" Height="20" CornerRadius="3"
                                    Background="#FFC107" Margin="16,0,4,0"/>
                            <TextBox x:Name="YellowColor" Width="80" Text="#FFC107"
                                     TextChanged="Color_Changed"/>
                            <Border x:Name="RedPreview" Width="20" Height="20" CornerRadius="3"
                                    Background="#F44336" Margin="16,0,4,0"/>
                            <TextBox x:Name="RedColor" Width="80" Text="#F44336"
                                     TextChanged="Color_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Notifications -->
            <TabItem Header="Уведомления">
                <StackPanel Margin="12">
                    <TextBlock Text="Точки звуковых уведомлений" Style="{StaticResource SectionLabel}"/>

                    <ListBox x:Name="AlertsList" Height="140" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,8,0"
                                              Checked="AlertEnabled_Changed" Unchecked="AlertEnabled_Changed"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Minutes}"/>
                                        <Run Text=" мин до таймера"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox x:Name="NewAlertMinutes" Width="50" Margin="0,0,8,0"/>
                        <Button Content="Добавить" Width="80" Margin="0,0,8,0" Click="AddAlert_Click"/>
                        <Button Content="Удалить" Width="80" Click="RemoveAlert_Click"/>
                    </StackPanel>

                    <TextBlock Text="Звуковой файл" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="SoundBuiltIn" Content="Встроенный" IsChecked="True"
                                     Checked="SoundSource_Changed" Margin="0,0,16,0"/>
                        <RadioButton x:Name="SoundCustom" Content="Свой файл"
                                     Checked="SoundSource_Changed"/>
                    </StackPanel>

                    <StackPanel x:Name="CustomSoundPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox x:Name="CustomSoundPath" Width="220" IsReadOnly="True" Margin="0,0,8,0"/>
                        <Button Content="Обзор..." Width="70" Margin="0,0,8,0" Click="BrowseSound_Click"/>
                    </StackPanel>

                    <Button Content="Прослушать" Width="100" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Click="PreviewSound_Click"/>
                </StackPanel>
            </TabItem>

            <!-- TAB: Settings -->
            <TabItem Header="Настройки">
                <StackPanel Margin="12">
                    <TextBlock Text="Действие по истечении таймера" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="ActionCombo" Width="200" HorizontalAlignment="Left"
                              Margin="0,0,0,16" SelectionChanged="Action_Changed">
                        <ComboBoxItem Content="Выключение компьютера" Tag="Shutdown"/>
                        <ComboBoxItem Content="Блокировка экрана" Tag="Lock"/>
                        <ComboBoxItem Content="Выход из учётной записи" Tag="Logoff"/>
                    </ComboBox>

                    <Border Background="#FFF3E0" CornerRadius="4" Padding="10" Margin="0,0,0,16">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#E65100">
                            Изменение действия защищено паролем. При попытке изменить будет запрошен пароль.
                        </TextBlock>
                    </Border>

                    <TextBlock Text="О программе" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                    <TextBlock Text="GameTimer v1.0" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="Таймер игрового времени для Windows" FontSize="12" Foreground="Gray"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
