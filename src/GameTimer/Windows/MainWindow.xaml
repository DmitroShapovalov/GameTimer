<ui:FluentWindow x:Class="GameTimer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="GameTimer"
        Width="500" Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="GameTimer"/>

        <TabControl Grid.Row="1" Margin="16,0,16,12">

            <!-- TAB: Timer -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Timer24" Margin="0,0,6,0"/>
                        <TextBlock Text="Таймер"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="16">
                    <!-- Mode selector -->
                    <TextBlock Text="Режим" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="ModeInterval" Content="Интервал" IsChecked="True"
                                     Checked="Mode_Changed" Margin="0,0,16,0"/>
                        <RadioButton x:Name="ModeAbsolute" Content="Время дня"
                                     Checked="Mode_Changed"/>
                    </StackPanel>

                    <!-- Interval inputs -->
                    <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Часы:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ui:TextBox x:Name="IntervalHours" Width="60" Text="1" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                        <TextBlock Text="Минуты:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ui:TextBox x:Name="IntervalMinutes" Width="60" Text="0" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                    </StackPanel>

                    <!-- Absolute inputs -->
                    <StackPanel x:Name="AbsolutePanel" Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="Collapsed">
                        <TextBlock Text="Час:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ui:TextBox x:Name="AbsoluteHour" Width="60" Text="20" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                        <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0,4,0" FontWeight="Bold"/>
                        <ui:TextBox x:Name="AbsoluteMinute" Width="60" Text="00" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                    </StackPanel>

                    <!-- Status -->
                    <ui:Card Margin="0,4,0,12">
                        <StackPanel>
                            <TextBlock x:Name="StatusText" Text="Таймер не запущен"
                                       FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RemainingText" Text=""
                                       FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="StartButton" Content="Старт" Width="100" Height="34"
                                Margin="0,0,8,0" Click="Start_Click"
                                Appearance="Success" FontWeight="Bold"/>
                        <ui:Button x:Name="StopButton" Content="Стоп" Width="100" Height="34"
                                Margin="0,0,8,0" Click="Stop_Click" IsEnabled="False"/>
                        <ui:Button x:Name="ResetButton" Content="Сброс" Width="100" Height="34"
                                Click="Reset_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- TAB: Display -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PaintBrush24" Margin="0,0,6,0"/>
                        <TextBlock Text="Отображение"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Position preview -->
                        <TextBlock Text="Позиция оверлея (перетащите маркер)" Style="{StaticResource SectionLabel}"/>
                        <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4"
                                Height="120" Margin="0,0,0,12" Background="#1a1a2e">
                            <Canvas x:Name="PositionCanvas" MouseLeftButtonDown="Canvas_MouseDown"
                                    MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp">
                                <Border x:Name="PositionMarker" Canvas.Left="0" Canvas.Top="0"
                                        Background="#4CAF50" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="01:30" Foreground="White" FontFamily="Consolas"
                                               FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Canvas>
                        </Border>

                        <!-- Font size -->
                        <TextBlock Text="Размер шрифта" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="72" Value="24"
                                    Width="280" VerticalAlignment="Center"
                                    ValueChanged="FontSize_Changed"/>
                            <TextBlock x:Name="FontSizeLabel" Text="24 px" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Width="50"/>
                        </StackPanel>

                        <!-- Opacity -->
                        <TextBlock Text="Прозрачность" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Value="70"
                                    Width="280" VerticalAlignment="Center"
                                    ValueChanged="Opacity_Changed"/>
                            <TextBlock x:Name="OpacityLabel" Text="70%" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Width="50"/>
                        </StackPanel>

                        <!-- Background toggle -->
                        <CheckBox x:Name="ShowBackgroundCheck" Content="Фон за текстом"
                                  IsChecked="True" Margin="0,4,0,12"
                                  Checked="DisplaySetting_Changed" Unchecked="DisplaySetting_Changed"/>

                        <!-- Color thresholds -->
                        <TextBlock Text="Пороги (минуты)" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Внимание с:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ui:TextBox x:Name="YellowThreshold" Width="55" Text="30"
                                     TextChanged="Threshold_Changed"/>
                            <TextBlock Text="мин" VerticalAlignment="Center" Margin="4,0,16,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Тревога с:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ui:TextBox x:Name="RedThreshold" Width="55" Text="10"
                                     TextChanged="Threshold_Changed"/>
                            <TextBlock Text="мин" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Colors -->
                        <TextBlock Text="Цвета зон (нажмите для выбора)" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,16,0">
                                <Border x:Name="GreenPreview" Width="40" Height="32" CornerRadius="4"
                                        Background="#4CAF50" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPicker_Click"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"/>
                                <TextBlock Text="Норма" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <Border x:Name="YellowPreview" Width="40" Height="32" CornerRadius="4"
                                        Background="#FFC107" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPicker_Click"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"/>
                                <TextBlock Text="Внимание" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <Border x:Name="RedPreview" Width="40" Height="32" CornerRadius="4"
                                        Background="#F44336" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPicker_Click"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"/>
                                <TextBlock Text="Тревога" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Notifications -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Alert24" Margin="0,0,6,0"/>
                        <TextBlock Text="Уведомления"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Точки звуковых уведомлений" Style="{StaticResource SectionLabel}"/>

                        <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Padding="4" Margin="0,0,0,8">
                            <ItemsControl x:Name="AlertsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Margin="0,0,8,0"
                                                      Checked="AlertEnabled_Changed" Unchecked="AlertEnabled_Changed"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                                <Run Text="{Binding Minutes}"/>
                                                <Run Text=" мин до таймера"/>
                                            </TextBlock>
                                            <ui:Button Grid.Column="2" Appearance="Secondary"
                                                       Width="30" Height="30" Padding="0"
                                                       Click="RemoveAlert_Click"
                                                       Tag="{Binding}"
                                                       ToolTip="Удалить">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14"/>
                                            </ui:Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:TextBox x:Name="NewAlertMinutes" Width="60" Margin="0,0,8,0"
                                        PlaceholderText="мин"/>
                            <ui:Button Content="Добавить" Width="120" Click="AddAlert_Click"
                                       Icon="{ui:SymbolIcon Add24}"/>
                        </StackPanel>

                        <TextBlock Text="Звуковой файл" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="SoundBuiltIn" Content="Встроенный" IsChecked="True"
                                         Checked="SoundSource_Changed" Margin="0,0,16,0"/>
                            <RadioButton x:Name="SoundCustom" Content="Свой файл"
                                         Checked="SoundSource_Changed"/>
                        </StackPanel>

                        <StackPanel x:Name="CustomSoundPanel" Orientation="Horizontal" Visibility="Collapsed"
                                    Margin="0,0,0,8">
                            <ui:TextBox x:Name="CustomSoundPath" Width="220" IsReadOnly="True" Margin="0,0,8,0"/>
                            <ui:Button Content="Обзор..." Width="80" Margin="0,0,8,0" Click="BrowseSound_Click"/>
                        </StackPanel>

                        <ui:Button Content="Прослушать" Width="140" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Click="PreviewSound_Click"
                                Icon="{ui:SymbolIcon Speaker224}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Settings -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0"/>
                        <TextBlock Text="Настройки"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="16">
                    <TextBlock Text="Действие по истечении таймера" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="ActionCombo" Width="220" HorizontalAlignment="Left"
                              Margin="0,0,0,16" SelectionChanged="Action_Changed">
                        <ComboBoxItem Content="Выключение компьютера"/>
                        <ComboBoxItem Content="Блокировка экрана"/>
                        <ComboBoxItem Content="Выход из учётной записи"/>
                    </ComboBox>

                    <ui:InfoBar Title="Защита" IsOpen="True" IsClosable="False"
                                Severity="Informational"
                                Message="Управление таймером защищено Windows Hello (PIN / отпечаток / лицо)."/>

                    <TextBlock Text="О программе" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                    <TextBlock Text="GameTimer v1.0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Таймер игрового времени для Windows" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
