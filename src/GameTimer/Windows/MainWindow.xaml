<ui:FluentWindow x:Class="GameTimer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="GameTimer"
        Width="500" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="GameTimer"/>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="16,0,16,12">

            <!-- TAB: Timer -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Timer24" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TabTimerText" Text="Timer"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="16">
                    <TextBlock x:Name="ModeLabel" Text="Mode" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="ModeInterval" Content="Interval" IsChecked="True"
                                     Checked="Mode_Changed" Margin="0,0,16,0"/>
                        <RadioButton x:Name="ModeAbsolute" Content="Time of day"
                                     Checked="Mode_Changed"/>
                    </StackPanel>

                    <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock x:Name="HoursLabel" Text="Hours:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ui:TextBox x:Name="IntervalHours" Width="80"
                                 PreviewKeyDown="TimeInput_PreviewKeyDown" PreviewTextInput="TimeInput_PreviewTextInput"
                                 GotKeyboardFocus="TimeInput_GotFocus" MaxLength="2" Text="1" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                        <TextBlock x:Name="MinutesLabel" Text="Minutes:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ui:TextBox x:Name="IntervalMinutes" Width="80"
                                 PreviewKeyDown="TimeInput_PreviewKeyDown" PreviewTextInput="TimeInput_PreviewTextInput"
                                 GotKeyboardFocus="TimeInput_GotFocus" MaxLength="2" Text="0" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                    </StackPanel>

                    <StackPanel x:Name="AbsolutePanel" Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="Collapsed">
                        <TextBlock x:Name="HourLabel" Text="Hour:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ui:TextBox x:Name="AbsoluteHour" Width="80"
                                 PreviewKeyDown="TimeInput_PreviewKeyDown" PreviewTextInput="TimeInput_PreviewTextInput"
                                 GotKeyboardFocus="TimeInput_GotFocus" MaxLength="2" Text="20" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                        <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0,4,0" FontWeight="Bold"/>
                        <ui:TextBox x:Name="AbsoluteMinute" Width="80"
                                 PreviewKeyDown="TimeInput_PreviewKeyDown" PreviewTextInput="TimeInput_PreviewTextInput"
                                 GotKeyboardFocus="TimeInput_GotFocus" MaxLength="2" Text="00" VerticalAlignment="Center"
                                 TextChanged="TimerInput_Changed"/>
                    </StackPanel>

                    <TextBlock x:Name="ValidationText" Text="" FontSize="12"
                               Foreground="#FF6B6B" Margin="0,0,0,4" Visibility="Collapsed"/>

                    <ui:Card Margin="0,4,0,12">
                        <StackPanel>
                            <TextBlock x:Name="StatusText" Text="Timer not started"
                                       FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RemainingText" Text=""
                                       FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </ui:Card>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="StartButton" Content="Start" Width="100" Height="34"
                                Margin="0,0,8,0" Click="Start_Click"
                                Appearance="Success" FontWeight="Bold"/>
                        <ui:Button x:Name="StopButton" Content="Stop" Width="100" Height="34"
                                Margin="0,0,8,0" Click="Stop_Click" IsEnabled="False"/>
                        <ui:Button x:Name="ResetButton" Content="Reset" Width="100" Height="34"
                                Click="Reset_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- TAB: Display -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PaintBrush24" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TabDisplayText" Text="Display"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock x:Name="OverlayPositionLabel" Text="Overlay position (drag the marker)" Style="{StaticResource SectionLabel}"/>
                        <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4"
                                Height="120" Margin="0,0,0,12" Background="#1a1a2e">
                            <Canvas x:Name="PositionCanvas" MouseLeftButtonDown="Canvas_MouseDown"
                                    MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp">
                                <Border x:Name="PositionMarker" Canvas.Left="0" Canvas.Top="0"
                                        Background="#4CAF50" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="01:30" Foreground="White" FontFamily="Consolas"
                                               FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Canvas>
                        </Border>

                        <TextBlock x:Name="FontSizeSectionLabel" Text="Font size" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="72" Value="24"
                                    Width="280" VerticalAlignment="Center"
                                    ValueChanged="FontSize_Changed"/>
                            <TextBlock x:Name="FontSizeLabel" Text="24 px" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Width="50"/>
                        </StackPanel>

                        <TextBlock x:Name="OpacitySectionLabel" Text="Opacity" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Value="70"
                                    Width="280" VerticalAlignment="Center"
                                    ValueChanged="Opacity_Changed"/>
                            <TextBlock x:Name="OpacityLabel" Text="70%" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Width="50"/>
                        </StackPanel>

                        <CheckBox x:Name="ShowBackgroundCheck" Content="Background behind text"
                                  IsChecked="True" Margin="0,4,0,12"
                                  Checked="DisplaySetting_Changed" Unchecked="DisplaySetting_Changed"/>

                        <TextBlock x:Name="ThresholdsLabel" Text="Thresholds (minutes)" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Name="WarningFromLabel" Text="Warning:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ui:TextBox x:Name="YellowThreshold" Width="55" Text="30"
                                     TextChanged="Threshold_Changed"/>
                            <TextBlock x:Name="MinLabel1" Text="min" VerticalAlignment="Center" Margin="4,0,16,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="AlertFromLabel" Text="Alert:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ui:TextBox x:Name="RedThreshold" Width="55" Text="10"
                                     TextChanged="Threshold_Changed"/>
                            <TextBlock x:Name="MinLabel2" Text="min" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock x:Name="ZoneColorsLabel" Text="Zone colors (click to choose)" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,16,0">
                                <Border x:Name="GreenPreview" Width="40" Height="32" CornerRadius="4"
                                        Background="#4CAF50" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPicker_Click"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"/>
                                <TextBlock x:Name="NormalZoneLabel" Text="Normal" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <Border x:Name="YellowPreview" Width="40" Height="32" CornerRadius="4"
                                        Background="#FFC107" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPicker_Click"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"/>
                                <TextBlock x:Name="WarningZoneLabel" Text="Warning" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <Border x:Name="RedPreview" Width="40" Height="32" CornerRadius="4"
                                        Background="#F44336" Cursor="Hand"
                                        MouseLeftButtonUp="ColorPicker_Click"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"/>
                                <TextBlock x:Name="AlertZoneLabel" Text="Alert" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Notifications -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Alert24" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TabNotificationsText" Text="Notifications"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock x:Name="AlertPointsLabel" Text="Sound alert points" Style="{StaticResource SectionLabel}"/>

                        <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Padding="4" Margin="0,0,0,8">
                            <ItemsControl x:Name="AlertsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Margin="0,0,8,0"
                                                      Checked="AlertEnabled_Changed" Unchecked="AlertEnabled_Changed"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       Text="{Binding DisplayText}"/>
                                            <ui:Button Grid.Column="2" Appearance="Secondary"
                                                       Width="30" Height="30" Padding="0"
                                                       Click="RemoveAlert_Click"
                                                       Tag="{Binding}">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14"/>
                                            </ui:Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:TextBox x:Name="NewAlertMinutes" Width="60" Margin="0,0,8,0"
                                        KeyDown="NewAlertMinutes_KeyDown" PreviewTextInput="TimeInput_PreviewTextInput" MaxLength="3"
                                        PlaceholderText="min"/>
                            <ui:Button x:Name="AddButton" Content="Add" Width="120" Click="AddAlert_Click"
                                       Icon="{ui:SymbolIcon Add24}"/>
                        </StackPanel>

                        <TextBlock x:Name="SoundFileLabel" Text="Sound file" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="SoundBuiltIn" Content="Built-in" IsChecked="True"
                                         Checked="SoundSource_Changed" Margin="0,0,16,0"/>
                            <RadioButton x:Name="SoundCustom" Content="Custom file"
                                         Checked="SoundSource_Changed"/>
                        </StackPanel>

                        <StackPanel x:Name="CustomSoundPanel" Orientation="Horizontal" Visibility="Collapsed"
                                    Margin="0,0,0,8">
                            <ui:TextBox x:Name="CustomSoundPath" Width="220" IsReadOnly="True" Margin="0,0,8,0"/>
                            <ui:Button x:Name="BrowseButton" Content="Browse..." Width="80" Margin="0,0,8,0" Click="BrowseSound_Click"/>
                        </StackPanel>

                        <ui:Button x:Name="PreviewButton" Content="Preview" Width="140" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Click="PreviewSound_Click"
                                Icon="{ui:SymbolIcon Speaker224}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: Settings -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TabSettingsText" Text="Settings"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock x:Name="LanguageLabel" Text="Language" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="LanguageCombo" Width="200" HorizontalAlignment="Left"
                                  Margin="0,0,0,16" SelectionChanged="Language_Changed">
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Русский" Tag="ru"/>
                        </ComboBox>

                        <TextBlock x:Name="ActionLabel" Text="Action when timer expires" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="ActionCombo" Width="220" HorizontalAlignment="Left"
                                  Margin="0,0,0,16" SelectionChanged="Action_Changed">
                            <ComboBoxItem x:Name="ActionShutdown" Content="Shut down computer"/>
                            <ComboBoxItem x:Name="ActionLock" Content="Lock screen"/>
                            <ComboBoxItem x:Name="ActionLogoff" Content="Log off"/>
                        </ComboBox>

                        <TextBlock x:Name="PhoneControlLabel" Text="Phone control" Style="{StaticResource SectionLabel}"/>
                        <ui:ToggleSwitch x:Name="RemoteToggle" Content="Allow control from a phone on home Wi-Fi"
                                         Checked="RemoteToggle_Changed" Unchecked="RemoteToggle_Changed"/>
                        <TextBlock x:Name="RemoteStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:Button x:Name="ConnectPhoneButton" Content="Connect phone" Click="ConnectPhone_Click"
                                   IsEnabled="False"/>

                        <TextBlock x:Name="PairedDevicesLabel" Text="Paired phones" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="NoDevicesText" Text="No phones connected yet" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ItemsControl x:Name="DevicesList" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding LastSeenText}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Appearance="Secondary"
                                                   Width="30" Height="30" Padding="0"
                                                   Click="RevokeDevice_Click" Tag="{Binding}">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="14"/>
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ui:InfoBar x:Name="ProtectionInfo" Title="Protection" IsOpen="True" IsClosable="False"
                                    Severity="Informational"
                                    Message="Timer controls are protected by Windows Hello (PIN / fingerprint / face)."/>

                        <TextBlock x:Name="AboutLabel" Text="About" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                        <TextBlock Text="GameTimer v1.0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="AppDescriptionText" Text="Game time limiter for Windows" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
