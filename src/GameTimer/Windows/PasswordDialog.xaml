<ui:FluentWindow x:Class="GameTimer.Windows.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Подтверждение"
        Width="340" Height="190"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        Topmost="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Подтверждение" ShowMaximize="False" ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Введите пароль Windows:" FontSize="13" Margin="0,0,0,8"/>

            <PasswordBox x:Name="PasswordInput" Grid.Row="1" FontSize="14" Padding="4"
                          KeyDown="PasswordInput_KeyDown"/>

            <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#FF4444" FontSize="11"
                       Margin="0,4,0,0" Visibility="Collapsed"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="OK" Width="80" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"
                           Appearance="Primary"/>
                <ui:Button Content="Отмена" Width="80" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
