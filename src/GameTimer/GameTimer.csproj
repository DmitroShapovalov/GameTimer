<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SystemMonitor</AssemblyName>
    <!-- Local builds; CI overrides it from the tag (-p:Version=x.y.z) -->
    <Version>1.5.0</Version>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Resolve WPF vs WinForms ambiguities: prefer WPF types globally -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Include="System.Windows" />
    <Using Include="System.Windows.Input" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!-- Embedded Kestrel for the phone remote (Phase 1) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>


  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\notification.mp3" />
    <!-- Web pages served to the phone; read by LogicalName, e.g. "Remote/pair.html" -->
    <EmbeddedResource Include="Remote\**\*" LogicalName="Remote/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
